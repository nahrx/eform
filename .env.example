# ── eForm Backend — example configuration ──────────────────────────
# Copy to .env and adjust the values.
#
# Local development : the application reads this .env file directly.
# Docker deployment : variables come from docker-compose.yml (no .env file is
#   needed inside the container; set them on the host or in CI instead).
# Override the .env path  : set ENV_FILE=/path/to/.env before starting.

# HTTP — default 8080
PORT=8080

# PostgreSQL (PG 13+ — needs the built-in gen_random_uuid)
# Use POSTGRES_* for the individual settings, or DATABASE_URL to override them outright.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eform
POSTGRES_SSLMODE=disable

# (optional) full override — when set, the POSTGRES_* values above are ignored
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/eform?sslmode=disable

# JWT — REQUIRED in production. Left empty, the server uses a random secret
# and every token becomes invalid on restart. Use a long random string.
JWT_SECRET=
JWT_RESPONDENT_SECRET=
# Token lifetime in hours — default 24
JWT_TTL_HOURS=24

# CORS — comma-separated list of origins, or * for all (default *).
# Production example: https://eform.bpskaltim.go.id,https://admin.bpskaltim.go.id
CORS_ORIGINS=*

# Public base URL — used to build share links (/f/{token})
PUBLIC_BASE_URL=http://localhost:8080

# Folder holding the application pages (login.html, admin.html, builder.html, public.html)
WEB_DIR=web

# Folder holding the public landing page (index.html) served at "/"
PUBLIC_DIR=public

# Organisation identity shown on the pages (tab title, landing page, form
# footer). Substituted when the page is served, so changing it here and
# restarting the server is enough — no HTML file needs editing.
ORGANISATION_NAME=BPS Provinsi Kalimantan Timur
ORGANISATION_NICKNAME=BPS Kaltim

# Initial superadmin — created once only, while the users table is still empty.
# CHANGE the password after the first login.
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@bps.go.id
SUPERADMIN_PASSWORD=admin12345

# ── Khusus Docker Compose ─────────────────────────────────────────────
# The variables below are read by docker-compose.yml only, not by the application.

# Credentials for the database created by the postgres service
POSTGRES_USER=eform
POSTGRES_PASSWORD=eform_secret
POSTGRES_DB=eform

# Host port mapped to the container's port 8080
APP_PORT=8080

GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=yyyy
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback